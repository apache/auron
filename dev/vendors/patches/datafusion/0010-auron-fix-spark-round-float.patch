+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_round_float64_half_up() -> Result<()> {
+        for (value, scale, expected) in [
+            (0.17149999999999999, 3, 0.171),
+            (-0.17149999999999999, 3, -0.171),
+            (0.1715, 3, 0.172),
+            (-0.1715, 3, -0.172),
+            (1.255, 2, 1.26),
+            (-1.255, 2, -1.26),
+            (1.005, 2, 1.01),
+            (-1.005, 2, -1.01),
+            (2.5, 0, 3.0),
+            (-2.5, 0, -3.0),
+            (125.0, -1, 130.0),
+            (-125.0, -1, -130.0),
+            (149.99999999999997, -2, 100.0),
+        ] {
+            assert_eq!(round_float(value, scale), expected);
+            let result = spark_round(
+                &[
+                    ColumnarValue::Scalar(ScalarValue::Float64(Some(value))),
+                    ColumnarValue::Scalar(ScalarValue::Int32(Some(scale))),
+                ],
+                false,
+            )?;
+            assert_eq!(
+                result.into_array(1)?.as_primitive::<Float64Type>(),
+                &Float64Array::from(vec![expected])
+            );
+            let result = spark_round(
+                &[
+                    ColumnarValue::Array(Arc::new(Float64Array::from(vec![
+                        Some(value),
+                        None,
+                    ]))),
+                    ColumnarValue::Scalar(ScalarValue::Int32(Some(scale))),
+                ],
+                false,
+            )?;
+            assert_eq!(
+                result.into_array(2)?.as_primitive::<Float64Type>(),
+                &Float64Array::from(vec![Some(expected), None])
+            );
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn test_round_float32_widened_to_double() -> Result<()> {
+        for (value, expected) in [(1.005_f32, 1.0_f32), (1.255, 1.25), (2.675, 2.67)] {
+            assert_eq!(round_float(value, 2), expected);
+            assert_eq!(round_float(-value, 2), -expected);
+            let result = spark_round(
+                &[
+                    ColumnarValue::Scalar(ScalarValue::Float32(Some(value))),
+                    ColumnarValue::Scalar(ScalarValue::Int32(Some(2))),
+                ],
+                false,
+            )?;
+            assert_eq!(
+                result.into_array(1)?.as_primitive::<Float32Type>(),
+                &Float32Array::from(vec![expected])
+            );
+            let result = spark_round(
+                &[
+                    ColumnarValue::Array(Arc::new(Float32Array::from(vec![
+                        Some(value),
+                        None,
+                    ]))),
+                    ColumnarValue::Scalar(ScalarValue::Int32(Some(2))),
+                ],
+                false,
+            )?;
+            assert_eq!(
+                result.into_array(2)?.as_primitive::<Float32Type>(),
+                &Float32Array::from(vec![Some(expected), None])
+            );
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn test_round_float_special_values_and_extreme_scales() {
+        for scale in [i32::MIN, -309, -308, 0, 308, 323, 324, i32::MAX] {
+            assert!(round_float(f64::NAN, scale).is_nan());
+            assert_eq!(round_float(f64::INFINITY, scale), f64::INFINITY);
+            assert_eq!(round_float(f64::NEG_INFINITY, scale), f64::NEG_INFINITY);
+            assert_eq!(round_float(-0.0_f64, scale).to_bits(), 0.0_f64.to_bits());
+        }
+        assert_eq!(round_float(f64::MAX, i32::MIN), 0.0);
+        assert_eq!(round_float(f64::MAX, -309), 0.0);
+        assert_eq!(round_float(f64::MAX, -308), f64::INFINITY);
+        assert_eq!(round_float(-f64::MAX, -308), f64::NEG_INFINITY);
+        assert_eq!(round_float(f64::MAX, 308), f64::MAX);
+        assert_eq!(round_float(f64::MAX, i32::MAX), f64::MAX);
+        assert_eq!(round_float(f64::from_bits(1), 324), f64::from_bits(1));
+        assert_eq!(round_float(f64::from_bits(1), 323), 1e-323);
+        assert_eq!(round_float(f64::from_bits(1), 322), 0.0);
+        assert_eq!(round_float(-0.0001_f64, 3).to_bits(), 0.0_f64.to_bits());
+        assert_eq!(round_float(f32::MAX, 38), f32::MAX);
+        assert_eq!(round_float(f32::MAX, -38), 3e38_f32);
+        assert_eq!(round_float(f32::MAX, -39), 0.0);
+    }
