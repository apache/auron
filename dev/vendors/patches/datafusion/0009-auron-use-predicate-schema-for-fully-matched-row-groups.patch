+        let table_schema = Arc::new(Schema::new(vec![
+            Field::new("c1", DataType::Int32, false),
+            Field::new("c2", DataType::Int32, true),
+        ]));
+        let expr = logical2physical(&col("c2").gt(lit(15)), &table_schema);
+        let pruning_predicate = build_test_pruning_predicate(expr, table_schema);
+        let file_schema = Schema::new(vec![Field::new("c1", DataType::Int32, false)]);
+        let schema_descr = get_test_schema_descr(vec![PrimitiveTypeField::new(
+            "c1",
+            PhysicalType::INT32,
+        )]);
+        let group = get_row_group_meta_data(
+            &schema_descr,
+            vec![ParquetStatistics::int32(
+                Some(16),
+                Some(20),
+                None,
+                Some(0),
+                false,
+            )],
+        );
+        let metrics = parquet_file_metrics();
+        let mut row_groups = RowGroupAccessPlanFilter::new(ParquetAccessPlan::new_all(1));
+        row_groups.prune_by_statistics(
+            &file_schema,
+            &schema_descr,
+            &[group],
+            &pruning_predicate,
+            &metrics,
+            None,
+        );
+
+        assert_eq!(row_groups.access_plan.row_group_indexes(), vec![0]);
+        assert_eq!(row_groups.is_fully_matched(), &vec![false]);
+    }
