+    #[test]
+    fn row_group_fully_matched_uses_predicate_schema() {
+        let table_schema = Arc::new(Schema::new(vec![
+            Field::new("c1", DataType::Boolean, false),
+            Field::new("c2", DataType::Int32, true),
+        ]));
+        let expr = logical2physical(&col("c2").gt(lit(15)), &table_schema);
+        let pruning_predicate = build_test_pruning_predicate(expr, table_schema);
+
+        for include_c1 in [false, true] {
+            let mut fields = vec![Field::new("c2", DataType::Int32, true)];
+            let mut parquet_fields =
+                vec![PrimitiveTypeField::new("c2", PhysicalType::INT32)];
+            if include_c1 {
+                fields.push(Field::new("c1", DataType::Boolean, false));
+                parquet_fields.push(PrimitiveTypeField::new("c1", PhysicalType::BOOLEAN));
+            }
+            let file_schema = Schema::new(fields);
+            let schema_descr = get_test_schema_descr(parquet_fields);
+            let groups = [Some(1), Some(0), None]
+                .into_iter()
+                .map(|null_count| {
+                    let mut statistics = vec![ParquetStatistics::int32(
+                        Some(16),
+                        Some(20),
+                        None,
+                        null_count,
+                        false,
+                    )];
+                    if include_c1 {
+                        statistics.push(ParquetStatistics::boolean(
+                            Some(false),
+                            Some(true),
+                            None,
+                            Some(0),
+                            false,
+                        ));
+                    }
+                    get_row_group_meta_data(&schema_descr, statistics)
+                })
+                .collect::<Vec<_>>();
+            let metrics = parquet_file_metrics();
+            let mut row_groups =
+                RowGroupAccessPlanFilter::new(ParquetAccessPlan::new_all(groups.len()));
+            row_groups.prune_by_statistics(
+                &file_schema,
+                &schema_descr,
+                &groups,
+                &pruning_predicate,
+                &metrics,
+                None,
+            );
+
+            assert_eq!(row_groups.access_plan.row_group_indexes(), vec![0, 1, 2]);
+            assert_eq!(row_groups.is_fully_matched(), &vec![false, true, false]);
+        }
+    }
+
