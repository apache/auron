+// Java Math.pow differs from libm for these NaN/infinity cases. For signed
+// zero, use powf directly so an odd exponent retains the negative sign.
+#[inline]
+fn spark_pow(base: f64, exponent: f64) -> f64 {
+    if exponent.is_nan() || (base.abs() == 1.0 && exponent.is_infinite()) {
+        f64::NAN
+    } else {
+        base.powf(exponent)
+    }
