+    /// auron: end-to-end regression test for dictionary-based row-group
+    /// pruning (patch 0005), going through the *real* `ParquetOpener::open`
+    /// path (a real file written by `ArrowWriter`, real metadata loaded
+    /// asynchronously via `AsyncFileReader`/`ArrowReaderMetadata::load_async`),
+    /// as opposed to the existing `test_dictionary_pruning_predicate` /
+    /// `test_get_dictionary_for_pruning_with_spark_like_metadata` tests,
+    /// which exercise the pruning-predicate / dictionary-fetch logic in
+    /// isolation against manually-crafted `ParquetMetaData`.
+    ///
+    /// This guards against two regressions that made dictionary pruning a
+    /// silent no-op even though the isolated unit tests above kept passing:
+    ///
+    /// 1. `ParquetMetaDataOptions` defaults to collapsing
+    ///    `page_encoding_stats` into a bitmask (the arrow-rs 59.2.0
+    ///    default), which drops the `DICTIONARY_PAGE` entries that
+    ///    `get_dictionary_for_pruning` needs. `ParquetOpener::open` now sets
+    ///    `with_encoding_stats_as_mask(false)` on the `ArrowReaderOptions` it
+    ///    loads metadata with, and Auron's own reader factory
+    ///    (`native-engine/.../parquet_exec.rs::ParquetFileReaderRef::get_metadata`)
+    ///    always loads metadata with that option, too (this test uses
+    ///    `MaskAwareReaderFactory` to mirror that behavior, since upstream's
+    ///    `DefaultParquetFileReaderFactory` silently drops it).
+    /// 2. `get_dictionary_for_pruning` itself used to unconditionally bail
+    ///    out for columns using the 2.0 `RLE_DICTIONARY` encoding -- the
+    ///    encoding `ArrowWriter` emits by default -- even when
+    ///    `page_encoding_stats` already proved there was no non-dictionary
+    ///    fallback page.
+    #[tokio::test]
+    async fn test_dictionary_pruning_end_to_end() {
+        let store = Arc::new(InMemory::new()) as Arc<dyn ObjectStore>;
+
+        // min='a', max='c', but the literal "b" is not actually present in
+        // the dictionary: plain min/max statistics pruning can NOT skip this
+        // row group (min <= 'b' <= max), only dictionary-aware pruning can.
+        let batch = datafusion_common::record_batch!((
+            "s",
+            Utf8,
+            vec![Some("a"), Some("c"), Some("a"), Some("c")]
+        ))
+        .unwrap();
+        let data_size =
+            write_parquet(Arc::clone(&store), "test.parquet", batch.clone()).await;
+        let file_bytes = store
+            .get(&Path::from("test.parquet"))
+            .await
+            .unwrap()
+            .bytes()
+            .await
+            .unwrap();
+
+        let schema = batch.schema();
+        let file = make_partitioned_file(data_size, "test.parquet");
+
+        let expr = col("s").eq(lit("b"));
+        let predicate = logical2physical(&expr, &schema);
+        let mut opener =
+            make_opener(&store, Some(predicate), schema.clone(), Arc::new([0]));
+        opener.parquet_file_reader_factory = Arc::new(MaskAwareReaderFactory(file_bytes));
+
+        let stream = opener.open(file).unwrap().await.unwrap();
+        let (num_batches, num_rows) = count_batches_and_rows(stream).await;
+        assert_eq!(
+            (num_batches, num_rows),
+            (0, 0),
+            "row group should have been pruned by real (non-mocked) dictionary pruning"
+        );
+    }
