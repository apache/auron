+    #[derive(Debug)]
+    struct TestSchemaAdapterFactory;
+
+    impl SchemaAdapterFactory for TestSchemaAdapterFactory {
+        fn create(
+            &self,
+            projected_table_schema: SchemaRef,
+            _table_schema: SchemaRef,
