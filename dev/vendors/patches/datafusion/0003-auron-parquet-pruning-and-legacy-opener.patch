+/// auron: build a pruning predicate for `starts_with(col, prefix)` by
+/// comparing the prefix of the column's min/max statistics against the
+/// literal prefix: `substr(col_min, 1, len) <= prefix && prefix <= substr(col_max, 1, len)`.
+fn build_starts_with_expr(
+    expr: &Arc<dyn PhysicalExpr>,
+    prefix: &str,
+    schema: &Schema,
+    required_columns: &mut RequiredColumns,
+) -> Option<Arc<dyn PhysicalExpr>> {
+    if let Some(col) = expr.downcast_ref::<phys_expr::Column>() {
+        let field = schema.field_with_name(col.name()).ok()?;
+
+        let min_field = &Field::new(field.name(), DataType::Utf8, true);
+        let min_column_expr = required_columns
+            .min_column_expr(col, expr, min_field)
+            .ok()?;
+
+        let max_field = &min_field.clone();
+        let max_column_expr = required_columns
+            .max_column_expr(col, expr, max_field)
+            .ok()?;
+
+        let lit_prefix = phys_expr::lit(prefix.to_owned());
+        let lit_1 = phys_expr::lit(1i64);
+        let lit_len = phys_expr::lit(prefix.len() as i64);
+        let config_options = Arc::new(ConfigOptions::default());
+
+        let min_prefix = Arc::new(ScalarFunctionExpr::new(
+            "substr",
+            datafusion_functions::unicode::substr(),
+            vec![min_column_expr, lit_1.clone(), lit_len.clone()],
+            Arc::new(Field::new("substr", DataType::Utf8, true)),
+            config_options.clone(),
+        ));
+        let max_prefix = Arc::new(ScalarFunctionExpr::new(
+            "substr",
+            datafusion_functions::unicode::substr(),
+            vec![max_column_expr, lit_1.clone(), lit_len.clone()],
+            Arc::new(Field::new("substr", DataType::Utf8, true)),
+            config_options,
+        ));
+
+        Some(Arc::new(phys_expr::BinaryExpr::new(
+            phys_expr::binary(min_prefix, Operator::LtEq, lit_prefix.clone(), schema)
+                .ok()?,
+            Operator::And,
+            phys_expr::binary(max_prefix, Operator::GtEq, lit_prefix.clone(), schema)
+                .ok()?,
+        )))
+    } else {
+        None
+    }
+}
