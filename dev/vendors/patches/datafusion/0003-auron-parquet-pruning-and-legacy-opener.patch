+    #[tokio::test]
+    async fn test_adaptive_batch_size() {
+        use arrow::array::{Int32Array, StringArray};
+        use parquet::file::metadata::ParquetMetaDataReader;
+
+        for (num_rows, width) in [(1024, 4096), (4, 2 * 1048576)] {
+            let store = Arc::new(InMemory::new()) as Arc<dyn ObjectStore>;
+            let schema = Arc::new(Schema::new(vec![
+                Field::new("id", DataType::Int32, false),
+                Field::new("payload", DataType::Utf8, false),
+            ]));
+            let padding = "x".repeat(width);
+            let batch = RecordBatch::try_new(
+                schema.clone(),
+                vec![
+                    Arc::new(Int32Array::from_iter_values(0..num_rows as i32)),
+                    Arc::new(StringArray::from_iter_values(
+                        (0..num_rows).map(|i| format!("{i}:{padding}")),
+                    )),
+                ],
+            )
+            .unwrap();
+            let data_size =
+                write_parquet(store.clone(), "test.parquet", batch.clone()).await;
+            let data = store
+                .get(&Path::from("test.parquet"))
+                .await
+                .unwrap()
+                .bytes()
+                .await
+                .unwrap();
+            let metadata = ParquetMetaDataReader::new()
+                .parse_and_finish(&data)
+                .unwrap();
+            assert_eq!(metadata.num_row_groups(), 1);
+            let row_group = metadata.row_group(0);
+
+            for projection in [vec![0, 1], vec![0], vec![]] {
+                let uncompressed_size = projection
+                    .iter()
+                    .map(|&idx| row_group.column(idx).uncompressed_size())
+                    .sum::<i64>();
+                let adaptive_size =
+                    (1048576 * num_rows as i64 / uncompressed_size.max(1)) as usize;
+                if projection.len() == 2 {
+                    assert!(adaptive_size < num_rows);
+                    if width > 1048576 {
+                        assert_eq!(adaptive_size, 0);
+                    }
+                } else {
+                    assert!(adaptive_size >= num_rows);
+                }
+
+                for batch_size in [num_rows, 1] {
+                    let expected_size = batch_size.min(adaptive_size).max(1);
+                    let expected = batch.project(&projection).unwrap();
+                    let mut opener = make_opener(
+                        &store,
+                        None,
+                        schema.clone(),
+                        Arc::from(projection.clone()),
+                    );
+                    opener.batch_size = batch_size;
+                    let file = make_partitioned_file(data_size, "test.parquet");
+                    let mut stream = opener.open(file).unwrap().await.unwrap();
+                    let mut offset = 0;
+                    while let Some(result) = stream.next().await {
+                        let output = result.unwrap();
+                        let expected_rows = expected_size.min(num_rows - offset);
+                        assert_eq!(output.num_rows(), expected_rows);
+                        assert_eq!(output, expected.slice(offset, expected_rows));
+                        offset += expected_rows;
+                    }
+                    assert_eq!(offset, num_rows);
+                }
+            }
+        }
+    }
