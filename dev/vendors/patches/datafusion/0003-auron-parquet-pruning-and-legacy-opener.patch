+            &self,
+            batch: RecordBatch,
+        ) -> datafusion_common::Result<RecordBatch> {
+            if batch.schema() == self.schema {
+                return Ok(batch);
+            }
+            Ok(RecordBatch::try_new(
+                Arc::clone(&self.schema),
+                batch.columns().to_vec(),
+            )?)
+        }
+
+        fn map_column_statistics(
+            &self,
