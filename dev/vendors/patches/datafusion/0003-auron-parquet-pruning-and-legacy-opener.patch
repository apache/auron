+    /// auron: dictionary-aware pruning predicate (patch 0018). `col = 'b'`
+    /// where min/max statistics are ['a', 'c'] (plain statistics pruning
+    /// keeps the row group) but the dictionary values are {a, c}: the
+    /// dictionary-aware predicate must prune the row group.
+    #[test]
+    fn test_dictionary_pruning_predicate() {
+        use arrow::array::{ArrayRef, ListArray, StringArray};
+        use arrow::buffer::{OffsetBuffer, ScalarBuffer};
+        use datafusion_common::Column;
+        use datafusion_common::pruning::PruningStatistics;
+        use datafusion_pruning::PruningPredicateBuilder;
+
+        let schema = Arc::new(Schema::new(vec![Field::new("s", DataType::Utf8, true)]));
+
+        // 'b' is within [min='a', max='c'] but absent from the dictionary {a, c}
+        let expr = col("s").eq(lit("b"));
+        let physical = logical2physical(&expr, &schema);
+        let predicate = PruningPredicateBuilder::new()
+            .with_file_schema(Arc::clone(&schema))
+            .build(physical)
+            .expect("predicate should build");
+
+        struct MockDictStats;
+        impl PruningStatistics for MockDictStats {
+            fn min_values(&self, _column: &Column) -> Option<ArrayRef> {
+                Some(Arc::new(StringArray::from(vec![Some("a")])))
+            }
+            fn max_values(&self, _column: &Column) -> Option<ArrayRef> {
+                Some(Arc::new(StringArray::from(vec![Some("c")])))
+            }
+            fn num_containers(&self) -> usize {
+                1
+            }
+            fn null_counts(&self, _column: &Column) -> Option<ArrayRef> {
+                Some(Arc::new(arrow::array::UInt64Array::from(vec![0])))
+            }
+            fn row_counts(&self) -> Option<ArrayRef> {
+                Some(Arc::new(arrow::array::UInt64Array::from(vec![2])))
+            }
+            fn contained(
+                &self,
+                _column: &Column,
+                _values: &std::collections::HashSet<ScalarValue>,
+            ) -> Option<arrow::array::BooleanArray> {
+                None
+            }
+            // dictionary values as ListArray: [[a, c]]
+            fn dictionary_values(&self, _column: &Column) -> Option<ArrayRef> {
+                let values = Arc::new(StringArray::from(vec![Some("a"), Some("c")]));
+                let offsets = OffsetBuffer::new(ScalarBuffer::from(vec![0, 2]));
+                let field = Arc::new(Field::new("item", DataType::Utf8, true));
+                Some(Arc::new(
+                    ListArray::try_new(field, offsets, values, None).unwrap(),
+                ))
+            }
+        }
+
+        let pruned = predicate
+            .prune(&MockDictStats)
+            .expect("prune should succeed");
+        assert!(!pruned[0], "row group must be pruned by dictionary");
+
+        // sanity: a value present in the dictionary must NOT be pruned
+        let expr = col("s").eq(lit("a"));
+        let physical = logical2physical(&expr, &schema);
+        let predicate = PruningPredicateBuilder::new()
+            .with_file_schema(Arc::clone(&schema))
+            .build(physical)
+            .expect("predicate should build");
+        let pruned = predicate
+            .prune(&MockDictStats)
+            .expect("prune should succeed");
+        assert!(pruned[0], "row group must be kept");
+    }
+
+    /// auron: verify that reading footer metadata with
+    /// `ParquetMetaDataOptions::with_encoding_stats_as_mask(false)` keeps the
+    /// full page encoding stats (including the DICTIONARY_PAGE entry), which
+    /// is the prerequisite for dictionary-based row group pruning. With the
+    /// default options (`encoding_stats_as_mask == true`) the stats are
+    /// reduced to a bitmask and `page_encoding_stats()` returns `None`,
+    /// silently disabling dictionary pruning.
+    #[tokio::test]
+    async fn test_page_encoding_stats_kept_with_mask_disabled() {
+        use futures::TryFutureExt;
+        use parquet::file::metadata::ParquetMetaDataOptions;
+
+        let store = Arc::new(InMemory::new()) as Arc<dyn ObjectStore>;
+        let batch =
+            datafusion_common::record_batch!(("s", Utf8, vec![Some("a"), Some("c")]))
+                .unwrap();
+        let data_size =
+            write_parquet(Arc::clone(&store), "test.parquet", batch.clone()).await;
+
+        let buf = store
+            .get(&Path::from("test.parquet"))
+            .await
+            .unwrap()
+            .bytes()
+            .await
+            .unwrap();
+
+        struct BufFetch(bytes::Bytes);
+        impl parquet::arrow::async_reader::MetadataFetch for BufFetch {
+            fn fetch(
+                &mut self,
+                range: std::ops::Range<u64>,
+            ) -> futures::future::BoxFuture<'_, parquet::errors::Result<bytes::Bytes>>
+            {
+                Box::pin(async move {
+                    Ok(self.0.slice(range.start as usize..range.end as usize))
+                })
+            }
+        }
+        let options = ParquetMetaDataOptions::new().with_encoding_stats_as_mask(false);
+        let meta = parquet::file::metadata::ParquetMetaDataReader::new()
+            .with_metadata_options(Some(options))
+            .load_and_finish(BufFetch(buf), data_size as u64)
+            .await
+            .unwrap();
+
+        let has_dict_page =
+            meta.row_groups()
+                .iter()
+                .flat_map(|rg| rg.columns())
+                .any(|c| {
+                    c.page_encoding_stats()
+                        .map(|stats| {
+                            stats.iter().any(|stat| {
+                                stat.page_type
+                                    == parquet::basic::PageType::DICTIONARY_PAGE
+                            })
+                        })
+                        .unwrap_or(false)
+                });
+        assert!(
+            has_dict_page,
+            "page encoding stats must be kept when encoding_stats_as_mask is disabled"
+        );
+    }
+
+    struct BufFetch(bytes::Bytes);
+    impl parquet::arrow::async_reader::MetadataFetch for BufFetch {
+        fn fetch(
+            &mut self,
+            range: std::ops::Range<u64>,
+        ) -> futures::future::BoxFuture<'_, parquet::errors::Result<bytes::Bytes>>
+        {
+            Box::pin(
+                async move { Ok(self.0.slice(range.start as usize..range.end as usize)) },
+            )
+        }
+    }
+
+    /// auron: E2E dictionary fetch with Spark-like column chunk metadata.
+    /// The file is written by arrow-rs (dictionary pages encoded with
+    /// RLE_DICTIONARY), so the column chunk metadata is re-synthesized the
+    /// way Spark/parquet-mr writes it (PLAIN_DICTIONARY v1 encoding stats)
+    /// while pointing at the real page offsets. This exercises the full
+    /// `get_dictionary_for_pruning` path against the vendored arrow 59.2.0
+    /// page reader APIs.
+    #[tokio::test]
+    async fn test_get_dictionary_for_pruning_with_spark_like_metadata() {
+        use arrow::array::BinaryArray;
+        use parquet::basic::{Encoding, PageType};
+        use parquet::file::metadata::{
+            ColumnChunkMetaData, PageEncodingStats, ParquetMetaDataOptions,
+            RowGroupMetaData,
+        };
+
+        let store = Arc::new(InMemory::new()) as Arc<dyn ObjectStore>;
+        let batch =
+            datafusion_common::record_batch!(("s", Utf8, vec![Some("a"), Some("c")]))
+                .unwrap();
+        let data_size =
+            write_parquet(Arc::clone(&store), "test.parquet", batch.clone()).await;
+        let buf = store
+            .get(&Path::from("test.parquet"))
+            .await
+            .unwrap()
+            .bytes()
+            .await
+            .unwrap();
+
+        // read the real metadata with full page encoding stats
+        let options = ParquetMetaDataOptions::new().with_encoding_stats_as_mask(false);
+        let meta = parquet::file::metadata::ParquetMetaDataReader::new()
+            .with_metadata_options(Some(options))
+            .load_and_finish(BufFetch(buf.clone()), data_size as u64)
+            .await
+            .unwrap();
+        let real_rg = &meta.row_groups()[0];
+        let real_col = real_rg.column(0);
+
+        // synthesize Spark-like (parquet-mr v1) column chunk metadata
+        let col_meta = ColumnChunkMetaData::builder(real_col.column_descr_ptr())
+            .set_num_values(real_col.num_values())
+            .set_compression(real_col.compression())
+            .set_total_compressed_size(real_col.compressed_size())
+            .set_total_uncompressed_size(real_col.uncompressed_size())
+            .set_data_page_offset(real_col.data_page_offset())
+            .set_dictionary_page_offset(real_col.dictionary_page_offset())
+            .set_encodings(vec![Encoding::PLAIN_DICTIONARY, Encoding::RLE])
+            .set_encodings_mask(parquet::basic::EncodingMask::new_from_encodings(
+                [Encoding::PLAIN_DICTIONARY, Encoding::RLE].iter(),
+            ))
+            .set_page_encoding_stats(vec![
+                PageEncodingStats {
+                    page_type: PageType::DICTIONARY_PAGE,
+                    encoding: Encoding::PLAIN_DICTIONARY,
+                    count: 1,
+                },
+                PageEncodingStats {
+                    page_type: PageType::DATA_PAGE,
+                    encoding: Encoding::PLAIN_DICTIONARY,
+                    count: 1,
+                },
+            ])
+            .build()
+            .unwrap();
+        let rg = RowGroupMetaData::builder(meta.file_metadata().schema_descr_ptr())
+            .set_num_rows(real_rg.num_rows())
+            .set_total_byte_size(real_rg.total_byte_size())
+            .add_column_metadata(col_meta)
+            .build()
+            .unwrap();
+
+        // a reader over the file bytes implementing get_bytes_sync
+        struct SyncFileReader {
+            data: bytes::Bytes,
+        }
+        impl parquet::arrow::async_reader::AsyncFileReader for SyncFileReader {
+            fn get_bytes(
+                &mut self,
+                range: std::ops::Range<u64>,
+            ) -> futures::future::BoxFuture<'_, parquet::errors::Result<bytes::Bytes>>
+            {
+                Box::pin(async move {
+                    Ok(self.data.slice(range.start as usize..range.end as usize))
+                })
+            }
+            fn get_metadata<'a>(
+                &'a mut self,
+                _options: Option<&'a parquet::arrow::arrow_reader::ArrowReaderOptions>,
+            ) -> futures::future::BoxFuture<
+                'a,
+                parquet::errors::Result<Arc<parquet::file::metadata::ParquetMetaData>>,
+            > {
+                Box::pin(async move {
+                    Err(parquet::errors::ParquetError::General(
+                        "not needed".to_string(),
+                    ))
+                })
+            }
+            fn get_bytes_sync(
+                &mut self,
+                range: std::ops::Range<u64>,
+            ) -> parquet::errors::Result<bytes::Bytes> {
+                Ok(self.data.slice(range.start as usize..range.end as usize))
+            }
+        }
+
+        let mut reader = SyncFileReader { data: buf };
+        let dict = parquet::auron::get_dictionary_for_pruning(&mut reader, &rg, 0)
+            .expect("dictionary fetch must not error");
+        let dict = dict.expect("dictionary must be retrieved");
+        let values = dict
+            .as_any()
+            .downcast_ref::<BinaryArray>()
+            .expect("dictionary values should be a BinaryArray");
+        let collected: Vec<&[u8]> = values.iter().flatten().collect();
+        assert!(
+            collected.contains(&b"a".as_slice()) && collected.contains(&b"c".as_slice()),
+            "dictionary must contain a and c, got {collected:?}"
+        );
+    }
+}
