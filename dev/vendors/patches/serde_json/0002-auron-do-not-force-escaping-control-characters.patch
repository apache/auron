From 95fa6cbac6b7146a8883f5ce761316d11282399b Mon Sep 17 00:00:00 2001
From: zhangli20 <zhangli20@kuaishou.com>
Date: Thu, 18 May 2023 14:26:01 +0800
Subject: [PATCH] auron do not force escaping control characters

---
 src/read.rs | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/read.rs b/src/read.rs
index cac8132..b88606d 100644
--- a/src/read.rs
+++ b/src/read.rs
@@ -791,8 +791,12 @@ static ESCAPE: [bool; 256] = {
     const __: bool = false; // allow unescaped
     [
         //   1   2   3   4   5   6   7   8   9   A   B   C   D   E   F
-        CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, // 0
-        CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, // 1
+        // CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, // 0
+        // CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, CT, // 1
+
+        // auron: will not escape any characters other than \0
+        CT, __, __, __, __, __, __, __, __, __, __, __, __, __, __, __, // 0
+        __, __, __, __, __, __, __, __, __, __, __, __, __, __, __, __, // 1
         __, __, QU, __, __, __, __, __, __, __, __, __, __, __, __, __, // 2
         __, __, __, __, __, __, __, __, __, __, __, __, __, __, __, __, // 3
         __, __, __, __, __, __, __, __, __, __, __, __, __, __, __, __, // 4
-- 
