@@ -778,6 +793,28 @@ mod lz4_hadoop_codec {
         }
 
         fn compress(&mut self, input_buf: &[u8], output_buf: &mut Vec<u8>) -> Result<()> {
+            // Hadoop's BlockCompressorStream splits its input into blocks of at most
+            // `io.compression.codec.lz4.buffersize` (256 KiB by default) bytes, and Hadoop's
+            // Lz4Decompressor (used by parquet-java) decompresses each block into a buffer of
+            // that size. A single frame holding a larger page fails on JVM readers with
+            // `LZ4Exception: Error decoding offset ...`, so emit one frame per 256 KiB chunk.
+            // try_decompress_hadoop already reads any number of frames.
+            if input_buf.is_empty() {
+                return self.compress_frame(input_buf, output_buf);
+            }
+            for chunk in input_buf.chunks(HADOOP_LZ4_BLOCK_SIZE) {
+                self.compress_frame(chunk, output_buf)?;
+            }
+            Ok(())
+        }
+    }
+
+    /// Default `io.compression.codec.lz4.buffersize` of Hadoop's Lz4Codec.
+    const HADOOP_LZ4_BLOCK_SIZE: usize = 256 * 1024;
+
+    impl LZ4HadoopCodec {
+        /// Appends one Hadoop LZ4 frame (sizes prefix + LZ4 block) for `input_buf`.
+        fn compress_frame(&mut self, input_buf: &[u8], output_buf: &mut Vec<u8>) -> Result<()> {
             // Allocate memory to store the LZ4_HADOOP prefix.
             let offset = output_buf.len();
             output_buf.resize(offset + PREFIX_LEN, 0);
@@ -885,6 +922,73 @@ mod tests {
         test_codec_without_size(CodecType::SNAPPY);
     }
 
+    #[test]
+    fn test_lz4_hadoop_frames_fit_hadoop_block_size() {
+        // pages larger than Hadoop's 256 KiB LZ4 buffer must be split into several frames,
+        // each of which a JVM (Hadoop Lz4Decompressor) reader can decompress
+        for size in [0, 1, 256 * 1024, 256 * 1024 + 1, 1024 * 1024 + 17] {
+            let data = random_bytes(size);
+            test_roundtrip(CodecType::LZ4, &data, Some(data.len()));
+
+            let mut codec = create_codec(CodecType::LZ4, &CodecOptionsBuilder::default().build())
+                .unwrap()
+                .unwrap();
+            let mut compressed = Vec::new();
+            codec.compress(&data, &mut compressed).unwrap();
+            let (mut pos, mut frames, mut total) = (0, 0, 0);
+            while pos < compressed.len() {
+                let raw = u32::from_be_bytes(compressed[pos..pos + 4].try_into().unwrap()) as usize;
+                let comp = u32::from_be_bytes(compressed[pos + 4..pos + 8].try_into().unwrap());
+                assert!(raw <= 256 * 1024, "frame of {raw} bytes exceeds the Hadoop block size");
+                total += raw;
+                frames += 1;
+                pos += 8 + comp as usize;
+            }
+            assert_eq!(pos, compressed.len());
+            assert_eq!(total, size);
+            assert_eq!(frames, size.div_ceil(256 * 1024).max(1));
+        }
+    }
+
+    #[test]
+    fn test_lz4_hadoop_reads_block_with_several_chunks() {
+        // Hadoop BlockCompressorStream writes a write() larger than its buffer as ONE original
+        // size header followed by several (compressed size, chunk) pairs; parquet-java does so
+        // for large dictionary pages. Build that layout by hand and read it back.
+        let data = random_bytes(600 * 1024 + 7);
+        let mut buf = Vec::new();
+        buf.extend_from_slice(&(data.len() as u32).to_be_bytes());
+        for chunk in data.chunks(256 * 1024) {
+            let compressed = lz4_flex::block::compress(chunk);
+            buf.extend_from_slice(&(compressed.len() as u32).to_be_bytes());
+            buf.extend_from_slice(&compressed);
+        }
+        // followed by a second, single-chunk block
+        let tail = random_bytes(1000);
+        let compressed = lz4_flex::block::compress(&tail);
+        buf.extend_from_slice(&(tail.len() as u32).to_be_bytes());
+        buf.extend_from_slice(&(compressed.len() as u32).to_be_bytes());
+        buf.extend_from_slice(&compressed);
+        // and the empty block header BlockCompressorStream.finish() appends after a large write
+        buf.extend_from_slice(&0u32.to_be_bytes());
+
+        let mut codec = create_codec(
+            CodecType::LZ4,
+            &CodecOptionsBuilder::default()
+                .set_backward_compatible_lz4(false)
+                .build(),
+        )
+        .unwrap()
+        .unwrap();
+        let mut out = Vec::new();
+        let n = codec
+            .decompress(&buf, &mut out, Some(data.len() + tail.len()))
+            .unwrap();
+        assert_eq!(n, data.len() + tail.len());
+        assert_eq!(&out[..data.len()], data.as_slice());
+        assert_eq!(&out[data.len()..], tail.as_slice());
+    }
+
     #[test]
     fn test_codec_gzip() {
         for level in GzipLevel::MINIMUM_LEVEL..=GzipLevel::MAXIMUM_LEVEL {
