 const RIGHT_TWELVE: u128 = 0x0000_0000_ffff_ffff_ffff_ffff_ffff_ffff;
 pub(crate) const NONCE_LEN: usize = 12;
@@ -108,6 +109,16 @@ impl CounterNonce {
     pub fn get_bytes(&self) -> [u8; NONCE_LEN] {
