From 0f9132f81a3a6d69ed2b893a5bc5d7820f819a4d Mon Sep 17 00:00:00 2001
From: zhangli20 <zhangli20@kuaishou.com>
Date: Mon, 16 Sep 2024 00:16:57 +0800
Subject: [PATCH] auron: expose fields of AsyncReader/ArrowReaderBuilder to
 public

---
 parquet/src/arrow/arrow_reader/mod.rs | 22 +++++++++++-----------
 parquet/src/arrow/async_reader/mod.rs |  2 +-
 2 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/parquet/src/arrow/arrow_reader/mod.rs b/parquet/src/arrow/arrow_reader/mod.rs
index 9127423ef..027b62b44 100644
--- a/parquet/src/arrow/arrow_reader/mod.rs
+++ b/parquet/src/arrow/arrow_reader/mod.rs
@@ -91,27 +91,27 @@ pub mod statistics;
 /// [`StatisticsConverter`]: statistics::StatisticsConverter
 /// [Querying Parquet with Millisecond Latency]: https://arrow.apache.org/blog/2022/12/26/querying-parquet-with-millisecond-latency/
 pub struct ArrowReaderBuilder<T> {
-    pub(crate) input: T,
+    pub input: T,
 
-    pub(crate) metadata: Arc<ParquetMetaData>,
+    pub metadata: Arc<ParquetMetaData>,
 
-    pub(crate) schema: SchemaRef,
+    pub schema: SchemaRef,
 
-    pub(crate) fields: Option<Arc<ParquetField>>,
+    pub fields: Option<Arc<ParquetField>>,
 
-    pub(crate) batch_size: usize,
+    pub batch_size: usize,
 
-    pub(crate) row_groups: Option<Vec<usize>>,
+    pub row_groups: Option<Vec<usize>>,
 
-    pub(crate) projection: ProjectionMask,
+    pub projection: ProjectionMask,
 
-    pub(crate) filter: Option<RowFilter>,
+    pub filter: Option<RowFilter>,
 
-    pub(crate) selection: Option<RowSelection>,
+    pub selection: Option<RowSelection>,
 
-    pub(crate) limit: Option<usize>,
+    pub limit: Option<usize>,
 
-    pub(crate) offset: Option<usize>,
+    pub offset: Option<usize>,
 }
 
 impl<T: Debug> Debug for ArrowReaderBuilder<T> {
diff --git a/parquet/src/arrow/async_reader/mod.rs b/parquet/src/arrow/async_reader/mod.rs
index 248de5be3..b9152f924 100644
--- a/parquet/src/arrow/async_reader/mod.rs
+++ b/parquet/src/arrow/async_reader/mod.rs
@@ -215,7 +215,7 @@ impl ArrowReaderMetadata {
 ///
 /// Allows sharing the same builder for both the sync and async versions, whilst also not
 /// breaking the pre-existing ParquetRecordBatchStreamBuilder API
-pub struct AsyncReader<T>(T);
+pub struct AsyncReader<T>(pub T);
 
 /// A builder for reading parquet files from an `async` source as  [`ParquetRecordBatchStream`]
 ///
-- 
2.50.1

