+use std::io::Read;
+use std::sync::{Arc, Mutex};
+
+use arrow_array::*;
+use arrow_schema::DataType;
+use bytes::Bytes;
+
+use crate::arrow::array_reader::byte_array::ByteArrayDecoderPlain;
+use crate::arrow::async_reader::AsyncFileReader;
+use crate::arrow::buffer::offset_buffer::OffsetBuffer;
+use crate::basic::{Encoding, PageType};
+use crate::column::page::{Page, PageReader};
+use crate::column::reader::{ColumnReader, get_column_reader};
+use crate::data_type::*;
+use crate::encodings::decoding::{Decoder, PlainDecoder};
+use crate::file::metadata::RowGroupMetaData;
+use crate::file::reader::{ChunkReader, Length, SerializedPageReader};
+
+pub fn get_dictionary_for_pruning<T: AsyncFileReader + Send + 'static + ?Sized>(
+    input: &mut T,
+    row_group_metadata: &RowGroupMetaData,
+    col_idx: usize,
+) -> crate::errors::Result<Option<ArrayRef>> {
+    let column_metadata = row_group_metadata.column(col_idx);
+
+    // check whether dictionary page exists
+    if column_metadata
+        .page_encoding_stats()
+        .iter()
+        .flat_map(|stats| stats.iter())
+        .all(|stat| stat.page_type != PageType::DICTIONARY_PAGE)
+    {
+        // no dictionary page
+        return Ok(None);
+    }
+
+    // check whether a data page using a non-dictionary encoding exists, if
+    // so, cannot use for pruning.
+    //
+    // auron: must only inspect `DATA_PAGE` entries here. The dictionary
+    // page's own `page_encoding_stats` entry always reports `PLAIN` (that's
+    // simply how the dictionary's values are encoded, per the parquet spec)
+    // regardless of whether the *data* pages use dictionary encoding; not
+    // filtering it out here made every dictionary-encoded column look like
+    // it had a "non-dictionary encoding" and silently disabled dictionary
+    // pruning entirely.
+    if column_metadata
+        .page_encoding_stats()
+        .iter()
+        .flat_map(|stats| stats.iter())
+        .filter(|stat| stat.page_type == PageType::DATA_PAGE)
+        .any(|stat| {
+            !matches!(
+                stat.encoding,
+                Encoding::PLAIN_DICTIONARY | Encoding::RLE_DICTIONARY
+            )
+        })
+    {
+        // at least one non-dictionary encoding is present
+        return Ok(None);
+    }
+
+    // auron: the two `page_encoding_stats`-based checks above already fully
+    // prove that every page in this column chunk is dictionary-encoded (one
+    // `DICTIONARY_PAGE`, and every page -- including this one -- uses either
+    // `PLAIN_DICTIONARY` (1.0 encoding) or `RLE_DICTIONARY` (2.0 encoding),
+    // with no `PLAIN` fallback). There used to be an additional
+    // `encodings_mask`-based check here that only trusted the legacy 1.0
+    // `PLAIN_DICTIONARY` encoding and unconditionally bailed out for 2.0's
+    // `RLE_DICTIONARY` (the encoding arrow-rs's `ArrowWriter` emits by
+    // default since at least arrow-rs 59.2.0), which made dictionary-based
+    // row-group pruning a permanent no-op for any file written with a
+    // reasonably modern parquet writer. Since `page_encoding_stats` already
+    // rules out the only case that check was guarding against (a page
+    // falling back to plain, non-dictionary encoding without updating
+    // `encodings()`), that check has been removed.
+
+    let mut page_reader: Box<dyn PageReader> = Box::new(SerializedPageReader::new(
+        Arc::new(WrappedChunkReader {
+            inner: Arc::new(Mutex::new(input)),
+            start: column_metadata.byte_range().0,
+            len: column_metadata.byte_range().1,
+        }),
+        column_metadata,
+        row_group_metadata.num_rows() as usize,
+        None,
+    )?);
+    let page_metadata = page_reader.peek_next_page()?;
+    if !page_metadata
+        .map(|metadata| metadata.is_dict)
+        .unwrap_or(false)
+    {
+        return Ok(None);
+    }
+
+    macro_rules! get_prim_dict {
+        ($r:expr, $parquet_type:ty, $array_type:ty) => {{
+            match $r.page_reader.get_next_page()? {
+                Some(Page::DictionaryPage {
+                    buf, num_values, ..
+                }) => {
+                    let mut dict_values = vec![Default::default(); num_values as usize];
+                    let mut dict_decoder = PlainDecoder::<$parquet_type>::new(
+                        column_metadata.column_descr().type_length(),
+                    );
+                    dict_decoder.set_data(buf, num_values as usize)?;
+                    dict_decoder.get(&mut dict_values)?;
+                    Ok(Some(Arc::new(<$array_type>::from_iter_values(dict_values))))
+                }
+                _ => Ok(None),
+            }
+        }};
+    }
+
+    // safety:
+    //  bypass lifetime checking.
+    //  page_reader is guarenteed not to be used outside its lifetime.
+    let unsafe_page_reader =
+        unsafe { std::mem::transmute::<Box<dyn PageReader>, Box<dyn PageReader>>(page_reader) };
+    match get_column_reader(column_metadata.column_descr_ptr(), unsafe_page_reader) {
+        ColumnReader::BoolColumnReader(_) => Ok(None),
+        ColumnReader::Int32ColumnReader(mut r) => {
+            get_prim_dict!(r, Int32Type, Int32Array)
+        }
+        ColumnReader::Int64ColumnReader(mut r) => {
+            get_prim_dict!(r, Int64Type, Int64Array)
+        }
+        ColumnReader::Int96ColumnReader(_) => Ok(None),
+        ColumnReader::FloatColumnReader(mut r) => {
+            get_prim_dict!(r, FloatType, Float32Array)
+        }
+        ColumnReader::DoubleColumnReader(mut r) => {
+            get_prim_dict!(r, DoubleType, Float64Array)
+        }
+        ColumnReader::ByteArrayColumnReader(mut r) => match r.page_reader.get_next_page()? {
+            Some(Page::DictionaryPage {
+                buf, num_values, ..
+            }) => {
+                let mut buffer = OffsetBuffer::<i32>::with_capacity(0);
+                let mut decoder = ByteArrayDecoderPlain::new(
+                    buf,
+                    num_values as usize,
+                    Some(num_values as usize),
+                    false,
+                );
+                decoder.read(&mut buffer, usize::MAX)?;
+                Ok(Some(buffer.into_array(None, DataType::Binary)))
+            }
+            _ => Ok(None),
+        },
+        ColumnReader::FixedLenByteArrayColumnReader(_) => Ok(None),
+    }
+}
+
+struct WrappedChunkReader<'a, T: AsyncFileReader + Send + 'static + ?Sized> {
+    inner: Arc<Mutex<&'a mut T>>,
+    start: u64,
+    len: u64,
+}
+unsafe impl<T: AsyncFileReader + Send + 'static + ?Sized> Sync for WrappedChunkReader<'_, T> {}
+
+impl<T: AsyncFileReader + Send + 'static + ?Sized> Read for WrappedChunkReader<'_, T> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        buf.copy_from_slice(self.get_bytes(self.start, buf.len())?.as_ref());
+        self.start += buf.len() as u64;
+        Ok(buf.len())
+    }
+}
+
+impl<T: AsyncFileReader + Send + 'static + ?Sized> Length for WrappedChunkReader<'_, T> {
+    fn len(&self) -> u64 {
+        self.len
+    }
+}
+impl<T: AsyncFileReader + Send + 'static + ?Sized> ChunkReader for WrappedChunkReader<'_, T> {
+    type T = Self;
+
+    fn get_read(&self, start: u64) -> crate::errors::Result<Self::T> {
+        Ok(Self {
+            inner: self.inner.clone(),
+            start,
+            len: self.len,
+        })
+    }
+
+    fn get_bytes(&self, start: u64, length: usize) -> crate::errors::Result<Bytes> {
+        // arrow-rs 59.2.0's `SerializedPageReader` passes *absolute* file
+        // offsets to both `get_read` and `get_bytes` (the Values state reads
+        // page headers via `get_read(offset)` and page bodies via
+        // `get_bytes(data_start, len)` with absolute `data_start`). Treat
+        // `start` as absolute here; `self.start` only tracks the sequential
+        // read position for the `Read` impl.
+        let end = start + length as u64;
+        let mut inner = self.inner.lock().unwrap();
+        inner.get_bytes_sync(start..end)
+    }
+}
