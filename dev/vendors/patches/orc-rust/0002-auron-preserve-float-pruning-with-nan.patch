+    #[test]
+    fn test_negated_float_predicate_keeps_maybe_matching_row_groups() {
+        use crate::predicate::{Predicate, PredicateValue};
+        use crate::proto::{r#type::Kind, Type};
+
+        let schema = crate::schema::RootDataType::from_proto(&[
+            Type {
+                kind: Some(Kind::Struct as i32),
+                subtypes: vec![1],
+                field_names: vec!["d".to_string()],
+                ..Default::default()
+            },
+            Type {
+                kind: Some(Kind::Double as i32),
+                ..Default::default()
+            },
+        ])
+        .unwrap();
+        let entry = |min, max, sum| {
+            RowGroupEntry::new(
+                Some(
+                    ColumnStatistics::try_from(&proto::ColumnStatistics {
+                        number_of_values: Some(2),
+                        double_statistics: Some(proto::DoubleStatistics {
+                            minimum: Some(min),
+                            maximum: Some(max),
+                            sum: Some(sum),
+                        }),
+                        ..Default::default()
+                    })
+                    .unwrap(),
+                ),
+                vec![],
+            )
+        };
+        let row_index = StripeRowIndex::new(
+            HashMap::from([(
+                1,
+                RowGroupIndex::new(
+                    vec![
+                        entry(0.0, 0.0, f64::NAN),
+                        entry(0.0, 10.0, 10.0),
+                        entry(100.0, 100.0, 200.0),
+                    ],
+                    2,
+                    1,
+                ),
+            )]),
+            6,
+            2,
+        );
+
+        let not_in = Predicate::not(Predicate::or(vec![
+            Predicate::eq("d", PredicateValue::Float64(Some(100.0))),
+            Predicate::eq("d", PredicateValue::Float64(Some(200.0))),
+        ]));
+        assert_eq!(
+            super::evaluate_predicate(&not_in, &row_index, &schema).unwrap(),
+            vec![true, true, false]
+        );
+
+        let not_equal = Predicate::not(Predicate::eq("d", PredicateValue::Float64(Some(5.0))));
+        assert_eq!(
+            super::evaluate_predicate(&not_equal, &row_index, &schema).unwrap(),
+            vec![true, true, true]
+        );
+    }
+
