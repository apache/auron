+    #[test]
+    fn test_float_comparison_keeps_uncertain_nan_statistics() {
+        use crate::predicate::{ComparisonOp, PredicateValue};
+
+        for (sum, keep) in [(Some(f64::NAN), true), (None, true), (Some(0.0), false)] {
+            let stats = ColumnStatistics::try_from(&proto::ColumnStatistics {
+                number_of_values: Some(2),
+                double_statistics: Some(proto::DoubleStatistics {
+                    minimum: Some(0.0),
+                    maximum: Some(0.0),
+                    sum,
+                }),
+                ..Default::default()
+            })
+            .unwrap();
+            let actual = super::evaluate_comparison_with_stats(
+                &stats,
+                ComparisonOp::GreaterThan,
+                &PredicateValue::Float64(Some(100.0)),
+            )
+            .unwrap();
+            assert_eq!(actual, keep);
+        }
+    }
